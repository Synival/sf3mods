; Consolidating spell power functions:
; ------------------------------------

; - getSpellAttackPowerInnate() + new subroutine
{ elf=x013changes.elf section=.getSpellPowerAttackInnate offset=0x1df8 until=0x1e8c }

; - getSpellAttackPowerScripted()
{ elf=x013changes.elf section=.getSpellPowerAttackScripted offset=0x1e8c until=0x1f0c }
