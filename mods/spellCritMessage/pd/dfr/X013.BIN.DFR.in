; Consolidating spell power functions:
; ------------------------------------

; - getSpellAttackPowerInnate() + new subroutine
{ elf=x013changes.elf section=.getSpellPowerAttackInnate offset=0x1c40 until=0x1cd4 }

; - getSpellAttackPowerScripted()
{ elf=x013changes.elf section=.getSpellPowerAttackScripted offset=0x1cd4 until=0x1d54 }
